{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitHub Link",
  "version": "0.1.0",
  "identifier": "com.fengc.github-link",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run bundle:prepare",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GitHub Link",
        "width": 460,
        "height": 650,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": ["../bundle-resources/"],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
